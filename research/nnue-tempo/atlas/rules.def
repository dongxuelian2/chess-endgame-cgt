RULE(king_takes_actor, "The black king takes the white nonking piece.")
RULE(man_takes_actor, "The black nonking piece takes its white counterpart.")
RULE(trade_last_men, "Black takes the white piece with its man and White can immediately recapture with its king.")
RULE(clean_man_capture, "Black takes the white piece with its man and White has no legal king recapture.")
RULE(quiet_promotion, "The black pawn promotes by advancing.")
RULE(capture_promotion, "The black pawn promotes by capture.")
RULE(underpromotion, "The black pawn promotes to a rook, bishop or knight.")
RULE(checking_promotion, "The promotion gives immediate check.")
RULE(surviving_promotion, "White has no legal immediate capture of the newly promoted unit.")
RULE(double_push, "The black pawn uses its initial two-square advance.")
RULE(single_push, "The black pawn advances one square without promotion.")
RULE(pawn_chase, "A nonpromoting pawn advance attacks the surviving white piece.")
RULE(king_unblocks_pawn, "The black king vacates the square immediately ahead of its pawn.")
RULE(escort_promotion, "A king move newly guards its pawn's promotion square.")
RULE(king_escorts_pawn, "A king move newly guards the black pawn.")
RULE(direct_check, "The moved nonking piece checks the white king.")
RULE(discovered_check, "A black king move uncovers a check from its own man.")
RULE(contact_check, "The checking man ends one king step from the white king.")
RULE(long_check, "The checking man ends at least three king steps from the white king.")
RULE(guarded_check, "The checking man is protected by its king.")
RULE(fork, "A checking move leaves the black man geometrically attacking the surviving white piece as well.")
RULE(skewer, "A sliding check lines up the white king in front of its surviving piece.")
RULE(pin, "The reply creates an absolute pin of the white piece against its king.")
RULE(unpin, "A black king move frees its man from an absolute pin.")
RULE(stay_on_pin_line, "An absolutely pinned black man makes a legal move along its pin line.")
RULE(escape_attack, "The attacked black man moves quietly to a square outside both white attack maps.")
RULE(king_rescue, "A king move newly guards a black man under geometric attack from White.")
RULE(king_fork_defence, "The black king newly attacks the white piece while guarding its own man.")
RULE(king_attack_loose, "The black king newly attacks a white piece outside its own king's guard.")
RULE(king_attack_guarded, "The black king newly attacks a white piece guarded by its own king.")
RULE(counterattack, "Under attack, the black man moves quietly and attacks the surviving white piece.")
RULE(attack_loose, "The black man newly attacks the white piece outside the white king's guard.")
RULE(attack_guarded, "The black man newly attacks the white piece inside the white king's guard.")
RULE(interpose_king, "The black king interposes between its man and an attacking white slider.")
RULE(orthogonal_opposition, "A king move establishes rank or file opposition with one intervening square.")
RULE(diagonal_opposition, "A king move establishes diagonal opposition with one intervening square.")
RULE(cut_king, "A quiet rook or queen move puts a complete attacked rank or file between the two kings.")
RULE(release_cut, "A king move ends on the rank or file of the white major piece and breaks its complete line cut.")
RULE(blockade_pawn, "A black man moves immediately in front of the white pawn.")
RULE(king_blockade, "The black king steps immediately in front of the white pawn.")
RULE(attack_promotion, "A black man newly attacks the white pawn's promotion square.")
RULE(attack_next_push, "A black man newly attacks the white pawn's next square.")
RULE(approach_white_pawn, "The black king reduces its distance to the surviving white pawn.")
RULE(leave_pawn_square, "A black pawn push puts its promotion square outside the white king's remaining one-step catch distance.")
RULE(attack_from_behind, "A black rook or queen newly attacks a white pawn along its file from behind.")
RULE(king_invasion, "The black king moves from outside into the inner four central squares.")
RULE(mate, "Black gives immediate checkmate.")
RULE(stalemate, "Black leaves White stalemated.")
